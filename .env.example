# RaceVerse environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# ─── Supabase (required) ────────────────────────────────────────────
# Backend repo: https://github.com/gomdolkim/RunningApi
# Get these from https://supabase.com/dashboard/project/itxecxuqtwjqcmszmezl/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://itxecxuqtwjqcmszmezl.supabase.co
# IMPORTANT: anon public key only. NEVER paste service_role here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Site (required) ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Map provider (optional, free demo style works without key) ─────
# Get free key at https://cloud.maptiler.com (100k tile reqs/month free)
NEXT_PUBLIC_MAPTILER_KEY=

# ─── Analytics / Observability (optional) ───────────────────────────
# Vercel Analytics is auto-injected when deployed to Vercel. No key needed.
# SENTRY_DSN=
